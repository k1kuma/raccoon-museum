---
import { mgr, url } from '../lib/data';
interface Props { id: string | null | undefined; link?: boolean; small?: boolean }
const { id, link = true, small = false } = Astro.props;
const m = mgr(id);
const Tag = link && id ? 'a' : 'span';
---
<Tag class:list={['chip', { 'chip-sm': small }]} href={link && id ? url(`managers/${id}`) : undefined} data-manager={id}>
  <span class="avatar" style={`--c:${m.color}`} aria-hidden="true">{m.initials}</span>
  <span class="chip-name">{m.name}</span>
</Tag>
