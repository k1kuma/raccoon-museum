---
import { mgr, url } from '../lib/data';
import Avatar from './Avatar.astro';
interface Props { id: string | null | undefined; link?: boolean; small?: boolean; season?: number | string }
const { id, link = true, small = false, season } = Astro.props;
const m = mgr(id);
const Tag = link && id ? 'a' : 'span';
---
<Tag class:list={['chip', { 'chip-sm': small }]} href={link && id ? url(`managers/${id}`) : undefined} data-manager={id}>
  <Avatar id={id} season={season} />
  <span class="chip-name">{m.name}</span>
</Tag>
