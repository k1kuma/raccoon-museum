---
import Chip from './Chip.astro';
import ShareButton from './ShareButton.astro';
import { url, segQuery } from '../lib/data';
interface Props { entry: any; pagePath: string; ranked?: boolean; compact?: boolean; segment?: string }
const { entry, pagePath, ranked = true, compact = false, segment = 'regular' } = Astro.props;
// Regular-season anchors stay `no-N` so older shared links keep working.
const anchor = segment === 'regular' ? `no-${entry.rank}` : `${segment}-no-${entry.rank}`;
---
<article class:list={['stat', { compact, 'is-new': entry.isNew }]} id={anchor} data-manager={entry.manager}>
  <div class="stat-head">
    {ranked && <span class="rank" aria-label={`Rank ${entry.rank}`}>#{entry.rank}</span>}
    <span class="stat-value">{entry.display}</span>
    {entry.isNew && <span class="badge badge-new">New this week</span>}
    {entry.active && <span class="badge badge-live">Active</span>}
  </div>
  <p class="caption">{entry.caption}</p>
  <div class="stat-foot">
    <Chip id={entry.manager} small />
    {entry.opponent && <span class="vs">vs</span>}
    {entry.opponent && <Chip id={entry.opponent} small />}
    {!compact && <ShareButton href={url(`${pagePath}${segQuery(segment)}#${anchor}`)} text={entry.caption} />}
  </div>
</article>
