---
import SegmentLabel from './SegmentLabel.astro';
import { url, segQuery, visibleIn } from '../lib/data';
interface Props { cat: any; section: string; segment?: string }
const { cat, section } = Astro.props;
// Toggle categories render one card per segment; fixed ones show in the toggle states they belong to.
const segment = Astro.props.segment ?? cat.segment;
const entries = Astro.props.segment && Astro.props.segment !== 'regular' ? cat.segments[Astro.props.segment] : cat.entries;
const dataSeg = Astro.props.segment ?? visibleIn(cat.segment);
const top = entries[0];
---
<a class="card wing-card" href={url(`${section}/${cat.slug}${segQuery(Astro.props.segment ?? '')}`)} data-manager={top?.manager} data-seg={dataSeg}>
  <div class="seg-row"><SegmentLabel segment={segment} /></div>
  <h3>{cat.title} {entries.some((e: any) => e.isNew) && <span class="badge badge-new">New</span>}</h3>
  <p class="muted">{cat.blurb}</p>
  {top ? (
    <>
      <p class="big">{top.display}</p>
      <p class="caption">{top.caption}</p>
    </>
  ) : <p class="caption muted">Nothing on display yet.</p>}
  <span class="more">See all {entries.length} →</span>
</a>
