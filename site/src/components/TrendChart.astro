---
// Weekly score vs the league median (solid gray) and average (dashed), rendered by a visx island.
// The island is server-rendered too, so the chart (and the table below) work without JavaScript.
import TrendViz from '../viz/TrendViz';
interface Week { week: number; pts: number; med: number; avg: number; res: string; opp?: string | null }
interface Props { weeks: Week[]; label: string }
const { weeks, label } = Astro.props;
const clean = weeks.map((w) => ({ ...w, opp: w.opp ?? undefined }));
---
<figure class="trend">
  <TrendViz client:visible weeks={clean} label={label} />
  <figcaption class="legend">
    <span><i class="k-pts"></i>Score</span><span><i class="k-med"></i>League median</span><span><i class="k-avg"></i>League average</span>
    <span><i class="k-up"></i>Above median</span><span><i class="k-down"></i>Below</span>
  </figcaption>
  <details class="trend-data">
    <summary>Week-by-week numbers</summary>
    <div class="table-wrap"><table>
      <thead><tr><th>Wk</th><th>Opp</th><th class="num">Score</th><th class="num">Median</th><th class="num">Avg</th><th>H2H</th></tr></thead>
      <tbody>{weeks.map((w) => (
        <tr><td>{w.week}</td><td>{w.opp ?? '—'}</td><td class={`num ${w.pts > w.med ? 'pos' : w.pts < w.med ? 'neg' : ''}`}>{w.pts.toFixed(2)}</td><td class="num">{w.med.toFixed(2)}</td><td class="num">{w.avg.toFixed(2)}</td><td>{w.res}</td></tr>
      ))}</tbody>
    </table></div>
  </details>
</figure>
