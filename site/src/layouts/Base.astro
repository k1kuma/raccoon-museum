---
import '@fontsource/roboto/latin-400.css';
import '@fontsource/roboto/latin-500.css';
import '@fontsource/roboto/latin-700.css';
import '@fontsource/roboto-condensed/latin-700.css';
import '../styles/global.css';
import Scoreboard from '../components/Scoreboard.astro';
import { meta, url, latestLabel } from '../lib/data';

interface Props {
  title: string;
  description?: string;
  wing?: string;
}
const { title, description, wing } = Astro.props;
const fullTitle = title === meta.leagueName ? title : `${title} · ${meta.leagueName} Museum`;
const desc = description || `The official museum of the ${meta.leagueName} fantasy football league.`;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const nav = [
  ['', 'Lobby', 'lobby'],
  ['champions', 'Champions', 'champions'],
  ['records', 'Records', 'records'],
  ['managers', 'Managers', 'managers'],
  ['rivalry', 'Rivalry Room', 'rivalry'],
  ['shame', 'Hall of Shame', 'shame'],
  ['archives', 'Archives', 'archives'],
];
const sortedManagers = [...meta.managers].sort((a, b) => a.name.localeCompare(b.name));
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={desc} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={url('favicon.svg')} type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={`${meta.leagueName} Museum`} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <meta name="theme-color" content="#1d1e1f" />
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body data-wing={wing}>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="masthead">
        <a class="brand" href={url()}>
          <span class="brand-mark" aria-hidden="true">🦝</span>
          <span><span class="brand-name">{meta.leagueName}</span><span class="brand-sub">Fantasy Football Museum</span></span>
        </a>
        <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="wings">
          <span class="menu-icon" aria-hidden="true"></span><span class="sr">Menu</span>
        </button>
        <label class="whoami">
          <span>Who are you?</span>
          <select id="whoami" aria-label="Highlight your team">
            <option value="">Just visiting</option>
            {sortedManagers.map((m) => <option value={m.id}>{m.name}</option>)}
          </select>
        </label>
      </div>
      <nav class="wings" id="wings" aria-label="Museum wings">
        {nav.map(([href, label, key]) => (
          <a href={url(href)} aria-current={wing === key ? 'page' : undefined}>{label}</a>
        ))}
      </nav>
    </header>
    <Scoreboard />
    {meta.isSample && (
      <div class="sample-banner" role="note">
        Exhibit preview: showing <strong>sample data</strong> until the Yahoo connection is set up.
      </div>
    )}
    <div class="updated">
      <span class="badge badge-updated">Updated through {latestLabel}{meta.latestFinished ? ' (final)' : ''}</span>
    </div>
    <main id="main">
      <slot />
    </main>
    <footer class="site-footer">
      <p>
        Data from <a href={meta.leagueUrl} rel="noopener">Yahoo Fantasy Football</a>, refreshed every Tuesday.
        Last built {new Date(meta.generatedAt).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}.
      </p>
      <p><a href={url('')}>Lobby</a> · <a href={url('archives')}>Archives</a> · <a href="https://github.com/k1kuma/raccoon-museum">Source</a></p>
    </footer>
    <div id="toast" class="toast" role="status" aria-live="polite"></div>
    <script>
      const header = document.querySelector('.site-header');
      const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
      toggle?.addEventListener('click', () => {
        const open = !header?.classList.contains('nav-open');
        header?.classList.toggle('nav-open', open);
        toggle.setAttribute('aria-expanded', String(open));
      });
      document.getElementById('wings')?.addEventListener('click', (e) => {
        if ((e.target as HTMLElement).closest('a') && header?.classList.contains('nav-open')) toggle?.click();
      });
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && header?.classList.contains('nav-open')) toggle?.click();
      });

      const KEY = 'ffm-me';
      const select = document.getElementById('whoami') as HTMLSelectElement | null;
      function applyMe(id: string) {
        document.body.dataset.me = id;
        document.querySelectorAll<HTMLElement>('[data-manager]').forEach((el) => {
          el.classList.toggle('is-me', !!id && el.dataset.manager === id);
        });
        document.querySelectorAll<HTMLElement>('[data-pair]').forEach((el) => {
          el.classList.toggle('is-me', !!id && (el.dataset.pair || '').split('--').includes(id));
        });
      }
      let stored = '';
      try { stored = localStorage.getItem(KEY) || ''; } catch {}
      if (select) {
        if (stored && [...select.options].some((o) => o.value === stored)) select.value = stored;
        else stored = '';
        select.addEventListener('change', () => {
          try { localStorage.setItem(KEY, select.value); } catch {}
          applyMe(select.value);
        });
      }
      applyMe(stored);

      // Regular / Playoffs / All toggle: state lives in ?segment= so shared links keep it.
      const SEGS = ['regular', 'playoffs', 'all'];
      function setSegment(seg: string, push: boolean) {
        if (!SEGS.includes(seg)) seg = 'regular';
        document.querySelectorAll<HTMLElement>('[data-segment-root]').forEach((el) => (el.dataset.segment = seg));
        document.querySelectorAll<HTMLElement>('[data-seg-btn]').forEach((b) =>
          b.setAttribute('aria-pressed', String(b.dataset.segBtn === seg)));
        if (push) {
          const u = new URL(location.href);
          if (seg === 'regular') u.searchParams.delete('segment'); else u.searchParams.set('segment', seg);
          u.hash = '';
          history.replaceState(null, '', u.href);
        }
      }
      if (document.querySelector('[data-segment-root]')) {
        const fromHash = SEGS.find((s) => location.hash.startsWith(`#${s}-`));
        setSegment(new URLSearchParams(location.search).get('segment') || fromHash || 'regular', false);
        if (location.hash) document.getElementById(location.hash.slice(1))?.scrollIntoView();
        document.addEventListener('click', (ev) => {
          const b = (ev.target as HTMLElement).closest<HTMLElement>('[data-seg-btn]');
          if (!b) return;
          ev.preventDefault();
          setSegment(b.dataset.segBtn || 'regular', true);
        });
      }

      const toast = document.getElementById('toast');
      function showToast(msg: string) {
        if (!toast) return;
        toast.textContent = msg;
        toast.classList.add('show');
        setTimeout(() => toast.classList.remove('show'), 2200);
      }
      document.addEventListener('click', async (ev) => {
        const btn = (ev.target as HTMLElement).closest<HTMLElement>('[data-share]');
        if (!btn) return;
        ev.preventDefault();
        const link = new URL(btn.dataset.share || '', location.href).href;
        const text = btn.dataset.text || document.title;
        if (navigator.share) {
          try { await navigator.share({ title: document.title, text, url: link }); return; } catch (e) {
            if ((e as DOMException).name === 'AbortError') return;
          }
        }
        try {
          await navigator.clipboard.writeText(link);
          showToast('Link copied!');
        } catch {
          window.prompt('Copy this link:', link);
        }
      });

      // "?" info tooltips: hover/focus on desktop, tap to toggle on touch, tap elsewhere / Escape / scroll to close.
      let openTip: HTMLButtonElement | null = null;
      const bubbleOf = (b: HTMLElement) => document.getElementById(b.getAttribute('aria-describedby') || '');
      const closeTip = () => {
        if (!openTip) return;
        bubbleOf(openTip)?.classList.remove('open');
        openTip.setAttribute('aria-expanded', 'false');
        openTip = null;
      };
      const openTipFor = (b: HTMLButtonElement) => {
        if (openTip === b) return;
        closeTip();
        const bub = bubbleOf(b);
        if (!bub) return;
        bub.classList.add('open');
        const r = b.getBoundingClientRect(), m = 8;
        const w = bub.offsetWidth, h = bub.offsetHeight;
        const left = Math.min(Math.max(m, r.left + r.width / 2 - w / 2), window.innerWidth - w - m);
        const top = r.bottom + 8 + h > window.innerHeight - m && r.top - 8 - h > m ? r.top - 8 - h : r.bottom + 8;
        bub.style.left = `${left}px`;
        bub.style.top = `${top}px`;
        b.setAttribute('aria-expanded', 'true');
        openTip = b;
      };
      document.querySelectorAll<HTMLButtonElement>('.infotip-btn').forEach((b) => {
        b.setAttribute('aria-expanded', 'false');
        let wasOpen: boolean | null = null;
        b.addEventListener('pointerdown', (e) => { wasOpen = e.pointerType !== 'mouse' && openTip === b; });
        b.addEventListener('click', (e) => {
          e.preventDefault();
          e.stopPropagation();
          const was = wasOpen ?? false;
          wasOpen = null;
          was ? closeTip() : openTipFor(b);
        });
        b.addEventListener('pointerenter', (e) => e.pointerType === 'mouse' && openTipFor(b));
        b.addEventListener('pointerleave', (e) => e.pointerType === 'mouse' && closeTip());
        b.addEventListener('focus', () => openTipFor(b));
        b.addEventListener('blur', closeTip);
      });
      document.addEventListener('pointerdown', (e) => {
        if (openTip && !(e.target as Element).closest?.('.infotip')) closeTip();
      });
      document.addEventListener('keydown', (e) => e.key === 'Escape' && closeTip());
      window.addEventListener('scroll', closeTip, { passive: true });
      window.addEventListener('resize', closeTip);
    </script>
  </body>
</html>
