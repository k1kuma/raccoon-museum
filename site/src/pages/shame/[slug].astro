---
import CategoryPage from '../../components/CategoryPage.astro';
import { shame } from '../../lib/data';

export function getStaticPaths() {
  return shame.map((cat) => ({ params: { slug: cat.slug }, props: { cat } }));
}
const { cat } = Astro.props;
---
<CategoryPage cat={cat} section="shame" sectionTitle="Hall of Shame" siblings={shame} />
