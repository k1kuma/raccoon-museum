---
import Base from '../../layouts/Base.astro';
import Chip from '../../components/Chip.astro';
import Avatar from '../../components/Avatar.astro';
import ShareButton from '../../components/ShareButton.astro';
import SegmentLabel from '../../components/SegmentLabel.astro';
import InfoTip from '../../components/InfoTip.astro';
import { archives, url, fmt, name, recordStr, ordinal } from '../../lib/data';

export function getStaticPaths() {
  return archives.map((s) => ({ params: { season: String(s.season) }, props: { s } }));
}
const { s } = Astro.props;
const path = `archives/${s.season}`;
const idx = archives.findIndex((a) => a.season === s.season);
const newer = archives[idx - 1];
const older = archives[idx + 1];
---
<Base title={`${s.season} Season Archive`} description={s.caption} wing="archives">
  <nav class="crumbs"><a href={url('archives')}>Archives</a> / <span>{s.season}</span></nav>
  <header class="page-head">
    <h1>{s.season} {!s.finished && <span class="badge badge-live">In progress</span>}</h1>
    <p class="lede">{s.caption}</p>
    <div class="season-nav">
      {older && <a class="pill" href={url(`archives/${older.season}`)}>← {older.season}</a>}
      <ShareButton href={url(path)} text={s.caption} label="Share season" />
      {newer && <a class="pill" href={url(`archives/${newer.season}`)}>{newer.season} →</a>}
    </div>
    <nav class="jump"><a href="#standings">Standings</a> · <a href="#bracket">Bracket</a> · <a href="#draft">Draft board</a> · <a href="#results">Results</a> · <a href="#trades">Trades</a></nav>
  </header>

  <section class="panel" id="standings">
    <div class="panel-head"><h2>{s.finished ? 'Regular-season standings' : `Standings through Week ${s.lastCompletedWeek}`}</h2><ShareButton href={url(`${path}#standings`)} /></div>
    <div class="seg-row"><SegmentLabel segment="regular" /><span class="muted">Record, points and seed are regular season only. Final finish is after the playoffs and consolation bracket.</span></div>
    <button type="button" class="pill opt-toggle" data-opt-toggle aria-pressed="false" aria-controls="standings-table">Show vs median, vs average, true record &amp; SOS</button>
    <div class="table-wrap">
      <table id="standings-table" class="has-opt">
        <thead><tr><th>Seed</th><th>Manager</th><th>Team</th><th>Record</th><th class="opt-col">vs median<InfoTip term="median" /></th><th class="opt-col">vs avg<InfoTip term="average" /></th><th class="opt-col">True<InfoTip term="true" /></th><th class="opt-col num">SOS<InfoTip term="sos" /></th><th class="num">PF</th><th class="num">PA</th><th>Final finish</th><th>Moves</th><th>Draft<InfoTip term="voe" /></th></tr></thead>
        <tbody>
          {s.standings.map((t: any, i: number) => (
            <tr data-manager={t.manager}>
              <td>{t.seed ?? i + 1}</td>
              <td><Chip id={t.manager} small season={s.season} /></td>
              <td>{t.team}</td>
              <td>{recordStr(t.wins, t.losses, t.ties)}</td>
              <td class="opt-col">{t.vsMedian ?? '—'}</td>
              <td class="opt-col">{t.vsAverage ?? '—'}</td>
              <td class="opt-col">{t.trueRecord ?? '—'}</td>
              <td class="opt-col num">{t.pastOppAllPlay != null ? `${(t.pastOppAllPlay * 100).toFixed(1)}%` : '—'}{t.pastRank ? <span class="muted"> ({ordinal(t.pastRank)})</span> : null}</td>
              <td class="num">{fmt(t.pointsFor)}</td>
              <td class="num">{fmt(t.pointsAgainst)}</td>
              <td>{t.finalRank ? (t.finalRank === 1 ? '🏆 1st' : ordinal(t.finalRank)) : '—'}</td>
              <td>{t.moves ?? '—'}{t.trades ? ` / ${t.trades}T` : ''}</td>
              <td>{t.draftGrade ? <a class={`grade grade-${t.draftGrade[0]}`} href="#draft-grades">{t.draftGrade}</a> : '—'}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <section class="panel" id="bracket">
    <div class="panel-head"><h2>Playoff bracket</h2><ShareButton href={url(`${path}#bracket`)} /></div>
    <div class="seg-row"><SegmentLabel segment="playoffs" /><span class="muted">Winners' bracket only; consolation games are in the weekly results.</span></div>
    {s.bracket.length === 0 ? <p class="empty">The playoffs haven't started yet.</p> : (
      <div class="bracket">
        {s.bracket.map((round: any) => (
          <div class="round">
            <h3>{round.name} <span class="muted">· Week {round.week}</span></h3>
            {round.games.map((g: any) => {
              const aWon = g.aPoints > g.bPoints;
              return (
                <div class:list={['game', { title: g.label === 'Championship' }]}>
                  {g.label && <span class="game-label">{g.label}</span>}
                  <div class:list={['side', { win: aWon }]} data-manager={g.a}><Chip id={g.a} small season={s.season} /><span class="num">{fmt(g.aPoints)}</span></div>
                  <div class:list={['side', { win: !aWon }]} data-manager={g.b}><Chip id={g.b} small season={s.season} /><span class="num">{fmt(g.bPoints)}</span></div>
                </div>
              );
            })}
          </div>
        ))}
      </div>
    )}
  </section>

  <section class="panel" id="draft">
    <div class="panel-head"><h2>Draft board</h2><ShareButton href={url(`${path}#draft`)} /></div>
    {s.draftBoard.length === 0 ? <p class="empty">No draft results on file.</p> : (
      <>
        <div id="draft-grades" class="dive-block">
          <h4>Draft report card <InfoTip term="voe" /></h4>
          <div class="seg-row"><SegmentLabel segment="season" /><span class="muted">Grades compare each pick's points{s.finished ? '' : ' so far'} with what that draft slot usually scores in this league.</span></div>
          <div class="table-wrap">
            <table class="grades">
              <thead><tr><th>#</th><th>Manager</th><th>Grade</th><th class="num">Value vs exp.</th><th class="num">Kept<InfoTip term="kept" /></th><th>Best pick</th><th>Worst pick</th></tr></thead>
              <tbody>
                {s.draftGrades.map((g: any) => (
                  <tr data-manager={g.manager}>
                    <td>{g.rank}</td>
                    <td><Chip id={g.manager} small season={s.season} /></td>
                    <td><span class={`grade grade-${g.grade[0]}`}>{g.grade}</span></td>
                    <td class:list={['num', g.voe >= 0 ? 'pos' : 'neg']}>{g.voe >= 0 ? '+' : ''}{fmt(g.voe, 0)}</td>
                    <td class="num">{fmt(g.kept, 0)}</td>
                    <td class="small">{g.best.player} <span class="muted">R{g.best.round} · +{fmt(g.best.voe, 0)}</span></td>
                    <td class="small">{g.worst.player} <span class="muted">R{g.worst.round} · {fmt(g.worst.voe, 0)}</span></td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
        <p class="muted draft-legend">Colour = points vs expected for that slot{s.finished ? '' : ' so far'}:
          <span class="tier tier-steal">Steal</span> <span class="tier tier-good">Good</span> <span class="tier tier-par">Par</span> <span class="tier tier-poor">Poor</span> <span class="tier tier-bust">Bust</span></p>
        <p class="swipe-hint muted" aria-hidden="true">Swipe the board sideways →</p>
        <div class="draft-scroll">
          <table class="draft">
            <thead><tr><th>Rd</th>{s.draftOrder.map((id: string) => <th data-manager={id}><Avatar id={id} season={s.season} /><span class="sr">{name(id)}</span></th>)}</tr></thead>
            <tbody>
              {s.draftBoard.map((rd: any) => {
                const byMgr = new Map(rd.picks.map((p: any) => [p.manager, p]));
                return (
                  <tr>
                    <th>{rd.round}</th>
                    {s.draftOrder.map((id: string) => {
                      const p: any = byMgr.get(id);
                      return p ? (
                        <td class:list={['pick', p.tier && `tier-${p.tier}`, `pos-${(p.position || '').replace('/', '')}`]} data-manager={id} title={`${p.caption} Expected for a ${p.posRank} pick: ${fmt(p.expected, 0)}.`}>
                          <span class="pick-no">#{p.pick}</span>
                          <span class="pick-name">{p.player}</span>
                          <span class="pick-meta">{p.posRank} · {fmt(p.points, 0)} pts · <b>{p.voe >= 0 ? '+' : ''}{fmt(p.voe, 0)}</b></span>
                        </td>
                      ) : <td></td>;
                    })}
                  </tr>
                );
              })}
            </tbody>
          </table>
        </div>
      </>
    )}
  </section>

  <section class="panel" id="results">
    <div class="panel-head"><h2>Weekly results</h2><ShareButton href={url(`${path}#results`)} /></div>
    {s.weeks.map((w: any, i: number) => (
      <details open={i === 0} id={`week-${w.week}`}>
        <summary>Week {w.week}{w.games.some((g: any) => g.type !== 'regular') ? ' · Playoffs & consolation' : ''}</summary>
        <ul class="results">
          {w.games.map((g: any) => (
            <li class:list={{ consolation: g.consolation }} data-type={g.type}>
              <span class:list={['r-side', { win: g.aPoints > g.bPoints }]} data-manager={g.a}><Avatar id={g.a} season={s.season} /> {name(g.a)} <span class="num">{fmt(g.aPoints)}</span></span>
              <span class="muted">–</span>
              <span class:list={['r-side', { win: g.bPoints > g.aPoints }]} data-manager={g.b}><span class="num">{fmt(g.bPoints)}</span> {name(g.b)} <Avatar id={g.b} season={s.season} /></span>
              {g.type !== 'regular' && <SegmentLabel segment={g.type === 'playoff' ? 'playoffs' : 'consolation'} />}
              {g.type !== 'regular' && g.label && <span class="game-label">{g.label}</span>}
            </li>
          ))}
        </ul>
      </details>
    ))}
  </section>

  <section class="panel" id="trades">
    <div class="panel-head"><h2>Trades</h2><ShareButton href={url(`${path}#trades`)} /></div>
    {s.trades.length === 0 ? <p class="empty">No trades this season. Everyone was too scared.</p> : (
      <ul class="headlines">{s.trades.map((t: any) => <li data-manager={t.manager}>{t.caption}</li>)}</ul>
    )}
  </section>
</Base>

<script>
  const btn = document.querySelector<HTMLButtonElement>('[data-opt-toggle]');
  const table = document.getElementById('standings-table');
  const set = (on: boolean) => {
    table?.classList.toggle('show-opt', on);
    btn?.setAttribute('aria-pressed', String(on));
    if (btn) btn.textContent = on ? 'Hide vs median, vs average, true record & SOS' : 'Show vs median, vs average, true record & SOS';
  };
  set(new URLSearchParams(location.search).get('cols') === 'median');
  btn?.addEventListener('click', () => {
    const on = btn.getAttribute('aria-pressed') !== 'true';
    set(on);
    const u = new URL(location.href);
    if (on) u.searchParams.set('cols', 'median'); else u.searchParams.delete('cols');
    history.replaceState(null, '', u);
  });
</script>
