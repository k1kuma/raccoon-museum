---
import Base from '../../layouts/Base.astro';
import { managers, url, fmt } from '../../lib/data';
import Avatar from '../../components/Avatar.astro';
const sorted = [...managers].sort((a, b) => (Number(b.active) - Number(a.active)) || b.titles.length - a.titles.length || b.career.pct - a.career.pct);
---
<Base title="Manager Exhibits" description="A portrait gallery of every manager in league history." wing="managers">
  <header class="page-head">
    <h1>Manager Exhibits</h1>
    <p class="lede">A portrait gallery of every manager to ever set a lineup in this league.</p>
  </header>
  <div class="wings-grid">
    {sorted.map((m) => (
      <a class="card portrait" href={url(`managers/${m.id}`)} data-manager={m.id}>
        <Avatar id={m.id} size="lg" />
        <h3>{m.name}{!m.active && <span class="badge">Alumni</span>}</h3>
        {m.nickname && <p class="muted">“{m.nickname}”</p>}
        <p><strong>{m.career.wins}-{m.career.losses}{m.career.ties ? `-${m.career.ties}` : ''}</strong>{m.titles.length > 0 && ` · ${'🏆'.repeat(m.titles.length)}`}</p>
        <p class="muted">{m.firstSeason}–{m.lastSeason} · {fmt(m.career.pointsFor, 0)} career points</p>
      </a>
    ))}
  </div>
</Base>
