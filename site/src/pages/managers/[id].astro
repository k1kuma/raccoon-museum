---
import Base from '../../layouts/Base.astro';
import Chip from '../../components/Chip.astro';
import Avatar from '../../components/Avatar.astro';
import ShareButton from '../../components/ShareButton.astro';
import SegmentLabel from '../../components/SegmentLabel.astro';
import TrendChart from '../../components/TrendChart.astro';
import CarryBar from '../../components/CarryBar.astro';
import InfoTip from '../../components/InfoTip.astro';
import { managers, fun, url, fmt, ordinal } from '../../lib/data';

export function getStaticPaths() {
  return managers.map((m) => ({ params: { id: m.id }, props: { m } }));
}
const { m } = Astro.props;
const c = m.career;
const path = `managers/${m.id}`;
const deep = [...m.seasons].reverse().filter((s: any) => s.trend || s.carry);
---
<Base title={`${m.name} — Manager Exhibit`} description={m.caption} wing="managers" ogImage={`og/managers/${m.id}.png`}>
  <nav class="crumbs"><a href={url('managers')}>Manager Exhibits</a> / <span>{m.name}</span></nav>
  <header class="page-head exhibit-head" data-manager={m.id}>
    <Avatar id={m.id} size="xl" />
    <div>
      <h1>{m.name}{!m.active && <span class="badge">Alumni</span>}</h1>
      {m.nickname && <p class="muted">“{m.nickname}”</p>}
      <p class="lede">{m.caption}</p>
      {m.bio && <p>{m.bio}</p>}
      <ShareButton href={url(path)} text={m.caption} label="Share exhibit" />
    </div>
  </header>

  <div class="kpi-group-head" id="career"><h2>Regular season</h2><SegmentLabel segment="regular" /></div>
  <section class="kpis">
    <div class="kpi"><span class="kpi-v">{c.wins}-{c.losses}{c.ties ? `-${c.ties}` : ''}</span><span class="kpi-l">Career record ({(c.pct * 100).toFixed(1)}%)</span></div>
    <div class="kpi"><span class="kpi-v">{c.allPlay.pct !== null ? `${c.allPlay.wins}-${c.allPlay.losses}${c.allPlay.ties ? `-${c.allPlay.ties}` : ''}` : '—'}</span><span class="kpi-l">All-play record<InfoTip term="allplay" />{c.allPlay.pct !== null ? ` (${(c.allPlay.pct * 100).toFixed(1)}%)` : ''}</span></div>
    <div class="kpi"><span class="kpi-v">{c.luck > 0 ? '+' : ''}{c.luck.toFixed(1)}</span><span class="kpi-l">Luck (wins vs all-play expected)<InfoTip term="luck" /></span></div>
    {c.vsMedian && <div class="kpi"><span class="kpi-v">{c.vsMedian}</span><span class="kpi-l">Record vs weekly median<InfoTip term="median" /> (vs average {c.vsAverage}<InfoTip term="average" />)</span></div>}
    {c.trueRecord && <div class="kpi"><span class="kpi-v">{c.trueRecord}</span><span class="kpi-l">True record (H2H + median, 2 games a week)<InfoTip term="true" /></span></div>}
    <div class="kpi"><span class="kpi-v">{fmt(c.pointsFor, 0)}</span><span class="kpi-l">Points for ({c.regularPpg ? fmt(c.regularPpg, 1) : '—'} per game)</span></div>
    <div class="kpi"><span class="kpi-v">{fmt(c.benchPoints, 0)}</span><span class="kpi-l">Points left on bench ({c.benchCostWins} lost wins)</span></div>
    <div class="kpi"><span class="kpi-v">{c.unluckyLosses}</span><span class="kpi-l">Losses with 2nd-best score</span></div>
    <div class="kpi"><span class="kpi-v">{c.trades}</span><span class="kpi-l">Trades · {c.moves ?? 0} moves</span></div>
  </section>
  <div class="kpi-group-head" id="playoffs"><h2>Playoffs</h2><SegmentLabel segment="playoffs" /></div>
  <section class="kpis">
    <div class="kpi"><span class="kpi-v">{'🏆'.repeat(m.titles.length) || '0'}</span><span class="kpi-l">Titles {m.titles.join(', ')}</span></div>
    <div class="kpi"><span class="kpi-v">{c.playoffWins}-{c.playoffLosses}</span><span class="kpi-l">Playoff record</span></div>
    <div class="kpi"><span class="kpi-v">{c.playoffApps}</span><span class="kpi-l">Appearances{c.completedSeasons ? ` in ${c.completedSeasons} seasons (${Math.round((c.playoffRate ?? 0) * 100)}%)` : ''}</span></div>
    <div class="kpi"><span class="kpi-v">{c.playoffByes}</span><span class="kpi-l">First-round byes</span></div>
    <div class="kpi"><span class="kpi-v">{c.clutch !== null ? `${c.clutch > 0 ? '+' : ''}${fmt(c.clutch, 1)}` : '—'}</span><span class="kpi-l">Clutch score<InfoTip term="clutch" />{c.playoffPpg ? ` (${fmt(c.playoffPpg, 1)} per playoff game)` : ''}</span></div>
    <div class="kpi"><span class="kpi-v">{c.bestFinish ? ordinal(c.bestFinish) : '—'}</span><span class="kpi-l">Best final finish (avg {c.avgFinish ?? '—'})</span></div>
  </section>

  {m.streak && (
    <p class="callout" data-manager={m.id}><span class="badge badge-live">Active streak</span> {m.streak.caption}</p>
  )}

  {deep.length > 0 && (
    <section class="panel" id="season-lab">
      <div class="panel-head"><h2>Season deep dive</h2><ShareButton href={url(`${path}#season-lab`)} /></div>
      <div class="seg-row"><SegmentLabel segment="regular" />
        <label class="season-pick">Season
          <select data-season-select>
            {deep.map((s: any, i: number) => <option value={s.season} selected={i === 0}>{s.season}{s.finished ? '' : ' (so far)'}</option>)}
          </select>
        </label>
      </div>
      {deep.map((s: any, i: number) => (
        <div class="season-dive" data-season-panel={s.season} data-default={i === 0 ? '1' : undefined}>
          <h3 class="dive-title">{s.season} · {s.team}</h3>
          {s.trend && (
            <div class="dive-block">
              <h4>Weekly scores vs the league <InfoTip term="median" /></h4>
              <p class="dive-sum"><strong>{s.trend.summary}</strong> vs median {s.vsMedian} · vs average {s.vsAverage} · head-to-head {s.wins}-{s.losses}{s.ties ? `-${s.ties}` : ''} · true record {s.trueRecord}{s.allPlay ? ` · all-play ${s.allPlay.record} (luck ${s.allPlay.luck > 0 ? '+' : ''}${s.allPlay.luck.toFixed(1)})` : ''}</p>
              <TrendChart weeks={s.trend.weeks} label={`${m.name} ${s.season}: weekly score against the league median and average. ${s.trend.summary}`} />
            </div>
          )}
          {s.carry && (
            <div class="dive-block">
              <h4>Who's carrying the team <InfoTip term="carry" /></h4>
              <p class="dive-sum"><strong>{s.carry.topName}: {Math.round(s.carry.top1 * 100)}% of starting points.</strong> Top 3 combined: {Math.round(s.carry.top3 * 100)}%. {s.carry.actual !== s.carry.without ? `Without ${s.carry.topName} (best eligible bench player instead): ${s.carry.actual} → ~${s.carry.without}.` : `Without ${s.carry.topName}, the record holds at ${s.carry.actual}.`}</p>
              <CarryBar carry={s.carry} />
            </div>
          )}
        </div>
      ))}
    </section>
  )}

  {m.lore.length > 0 && (
    <section class="panel"><h2>Lore</h2><ul class="lore">{m.lore.map((l: string) => <li>{l}</li>)}</ul></section>
  )}

  <div class="grid-2">
    {m.highestScore && (
      <section class="panel" id="best-week">
        <div class="panel-head"><h2>Best week</h2><ShareButton href={url(`${path}#best-week`)} /></div>
        <div class="seg-row"><SegmentLabel segment="regular" /></div>
        <p class="big">{fmt(m.highestScore.points)}</p>
        <p>{m.highestScore.label} vs <Chip id={m.highestScore.opponent} small /> ({m.highestScore.result} {fmt(m.highestScore.points)}–{fmt(m.highestScore.opponentPoints)})</p>
      </section>
    )}
    {m.lowestScore && (
      <section class="panel" id="worst-week">
        <div class="panel-head"><h2>Worst week</h2><ShareButton href={url(`${path}#worst-week`)} /></div>
        <div class="seg-row"><SegmentLabel segment="regular" /></div>
        <p class="big">{fmt(m.lowestScore.points)}</p>
        <p>{m.lowestScore.label} vs <Chip id={m.lowestScore.opponent} small /> ({m.lowestScore.result} {fmt(m.lowestScore.points)}–{fmt(m.lowestScore.opponentPoints)})</p>
      </section>
    )}
  </div>

  {m.draftCareer && (
    <section class="panel" id="draft-grades">
      <div class="panel-head"><h2>Draft report card <InfoTip term="voe" /></h2><ShareButton href={url(`${path}#draft-grades`)} /></div>
      <div class="seg-row"><SegmentLabel segment="season" /><span class="muted">Career draft GPA <b>{m.draftCareer.gpa.toFixed(2)}</b> · value vs expected {m.draftCareer.voe >= 0 ? '+' : ''}{fmt(m.draftCareer.voe, 0)} pts</span></div>
      <div class="table-wrap">
        <table class="grades">
          <thead><tr><th>Season</th><th>Grade</th><th class="num">Rank</th><th class="num">Value vs exp.</th><th class="num">Kept<InfoTip term="kept" /></th><th>Steal</th><th>Bust</th></tr></thead>
          <tbody>
            {[...m.seasons].reverse().filter((s: any) => s.draft).map((s: any) => (
              <tr>
                <td><a href={url(`archives/${s.season}#draft`)}>{s.season}</a>{!s.draft.final && <span class="muted"> (so far)</span>}</td>
                <td><span class={`grade grade-${s.draft.grade[0]}`}>{s.draft.grade}</span></td>
                <td class="num">{ordinal(s.draft.rank)}</td>
                <td class:list={['num', s.draft.voe >= 0 ? 'pos' : 'neg']}>{s.draft.voe >= 0 ? '+' : ''}{fmt(s.draft.voe, 0)}</td>
                <td class="num">{fmt(s.draft.kept, 0)}</td>
                <td class="small">{s.draft.best.player} <span class="muted">R{s.draft.best.round} · +{fmt(s.draft.best.voe, 0)}</span></td>
                <td class="small">{s.draft.worst.player} <span class="muted">R{s.draft.worst.round} · {fmt(s.draft.worst.voe, 0)}</span></td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>
  )}

  <section class="panel" id="cabinet">
    <div class="panel-head"><h2>Awards cabinet</h2><ShareButton href={url(`${path}#cabinet`)} /></div>
    {Object.keys(m.cabinet).length === 0 ? <p class="empty">No weekly awards yet.</p> : (
      <ul class="cabinet">
        {fun.awards.filter((a: any) => m.cabinet[a.slug]).map((a: any) => (
          <li><a href={url(`fun/awards/${a.slug}`)}><span class="award-icon" aria-hidden="true">{a.icon}</span> {a.title} <b>×{m.cabinet[a.slug]}</b></a></li>
        ))}
      </ul>
    )}
  </section>

  <div class="grid-2">
    <section class="panel" id="best-picks">
      <div class="panel-head"><h2>Best draft picks</h2><ShareButton href={url(`${path}#best-picks`)} /></div>
      {m.bestPicks.length === 0 ? <p class="empty">No draft data yet.</p> : (
        <ol class="mini-list">{m.bestPicks.map((p: any) => <li><strong>{p.player}</strong> <span class="muted">({p.position}, {p.season}, pick #{p.pick})</span><br />{p.caption}</li>)}</ol>
      )}
    </section>
    <section class="panel" id="worst-picks">
      <div class="panel-head"><h2>Worst draft picks</h2><ShareButton href={url(`${path}#worst-picks`)} /></div>
      {m.worstPicks.length === 0 ? <p class="empty">No draft data yet.</p> : (
        <ol class="mini-list">{m.worstPicks.map((p: any) => <li><strong>{p.player}</strong> <span class="muted">({p.position}, {p.season}, pick #{p.pick})</span><br />{p.caption}</li>)}</ol>
      )}
    </section>
  </div>

  <div class="grid-2">
    <section class="panel" id="best-trades">
      <div class="panel-head"><h2>Best trades</h2><ShareButton href={url(`${path}#best-trades`)} /></div>
      {m.bestTrades.length === 0 ? <p class="empty">No trades on record.</p> : (
        <ol class="mini-list">{m.bestTrades.map((t: any) => <li><strong class="pos">+{fmt(t.net)}</strong> {t.caption}</li>)}</ol>
      )}
    </section>
    <section class="panel" id="worst-trades">
      <div class="panel-head"><h2>Worst trades</h2><ShareButton href={url(`${path}#worst-trades`)} /></div>
      {m.worstTrades.length === 0 ? <p class="empty">No regrettable trades. Suspicious.</p> : (
        <ol class="mini-list">{m.worstTrades.map((t: any) => <li><strong class="neg">{fmt(t.net)}</strong> {t.caption}</li>)}</ol>
      )}
    </section>
  </div>

  <section class="panel" id="seasons">
    <div class="panel-head"><h2>Season by season</h2><ShareButton href={url(`${path}#seasons`)} /></div>
    <p class="muted">Record, vs median (a bonus game each week against the league's median score), true record (both combined), points and seed: regular season. Playoffs: winners'-bracket games. Final finish includes the consolation bracket.</p>
    <div class="table-wrap">
      <table>
        <thead><tr><th>Season</th><th>Team</th><th>Record</th><th>vs median<InfoTip term="median" /></th><th>True<InfoTip term="true" /></th><th class="num">PF</th><th class="num">SOS<InfoTip term="sos" /></th><th>Seed</th><th>Playoffs</th><th>Final finish</th></tr></thead>
        <tbody>
          {[...m.seasons].reverse().map((s: any) => (
            <tr>
              <td><a href={url(`archives/${s.season}`)}>{s.season}</a></td>
              <td>{s.team}</td>
              <td>{s.wins}-{s.losses}{s.ties ? `-${s.ties}` : ''}</td>
              <td>{s.vsMedian ?? '—'}</td>
              <td>{s.trueRecord ?? '—'}</td>
              <td class="num">{fmt(s.pointsFor)}</td>
              <td class="num">{s.sos?.pastOppAllPlay != null ? `${(s.sos.pastOppAllPlay * 100).toFixed(1)}%` : '—'}{s.sos?.pastRank ? <span class="muted"> ({ordinal(s.sos.pastRank)})</span> : null}{s.sos?.remainingOppAllPlay != null ? <span class="muted small"><br />left: {(s.sos.remainingOppAllPlay * 100).toFixed(1)}%</span> : null}</td>
              <td>{s.seed ?? '—'}</td>
              <td>{s.playoffRecord ?? (s.madePlayoffs ? '—' : s.finished ? 'Missed' : '—')}{s.bye ? ' · bye' : ''}</td>
              <td>{s.finished ? (s.rank === 1 ? '🏆 Champion' : s.rank ? ordinal(s.rank) : '—') : 'In progress'}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <section class="panel" id="rivals">
    <div class="panel-head"><h2>Head-to-head</h2><ShareButton href={url(`${path}#rivals`)} /></div>
    <div class="table-wrap">
      <table>
        <thead><tr><th>Opponent</th><th>Regular season</th><th>Playoffs</th><th></th></tr></thead>
        <tbody>
          {m.rivals.map((r: any) => (
            <tr data-manager={r.opponent}>
              <td><Chip id={r.opponent} small /></td>
              <td>{r.meetings ? `${r.wins}-${r.losses}${r.ties ? `-${r.ties}` : ''}` : '—'}</td>
              <td>{r.playoffMeetings ? `${r.playoffWins}-${r.playoffLosses}` : '—'}</td>
              <td><a href={url(`rivalry/${r.pair}`)}>Rivalry →</a></td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>
</Base>

<script>
  const pick = document.querySelector<HTMLSelectElement>('[data-season-select]');
  const show = (season: string) => {
    document.querySelectorAll<HTMLElement>('[data-season-panel]').forEach((el) => {
      el.hidden = el.dataset.seasonPanel !== season;
    });
  };
  if (pick) {
    const want = new URLSearchParams(location.search).get('season');
    if (want && [...pick.options].some((o) => o.value === want)) pick.value = want;
    show(pick.value);
    pick.closest('section')?.classList.add('ready');
    pick.addEventListener('change', () => {
      show(pick.value);
      const u = new URL(location.href);
      u.searchParams.set('season', pick.value);
      u.hash = 'season-lab';
      history.replaceState(null, '', u);
    });
  }
</script>
